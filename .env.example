# =====================================================================
# QuantMind 环境变量模板（脱敏版）
# =====================================================================
# 1. 复制本文件为 .env： cp .env.example .env
# 2. 把所有 <...> 占位符替换成你自己的真实值
# 3. .env 已加入 .gitignore，永远不会被提交到 Git
# 4. 任何密钥一旦泄露（误提交、误上传），请立刻到对应厂商控制台轮换
# =====================================================================

# ============================ MySQL 数据库 ============================
WUCAI_SQL_HOST=localhost
WUCAI_SQL_PORT=3309
WUCAI_SQL_USERNAME=root
WUCAI_SQL_PASSWORD=<your_mysql_password>
WUCAI_SQL_DB=wucai_trade

# ============================ FastAPI 服务 =============================
API_HOST=0.0.0.0
API_PORT=8000

# ============================ 日志 =============================
LOG_LEVEL=INFO
# 不填则使用默认 data/logs
# LOG_DIR=/path/to/logs

# ============================ K线 / 行情同步 ========================
# 东方财富 Cookie（可选）。留空时由程序自动获取，建议仅在限流时手工填写
# 仅保存在本机 .env，不要提交到 Git 或贴到 issue/PR
EASTMONEY_COOKIE=
EASTMONEY_PAGE_URL=https://quote.eastmoney.com/
EASTMONEY_KLINE_URL=https://push2his.eastmoney.com/api/qt/stock/kline/get
KLINE_REQUEST_TIMEOUT=20
KLINE_DATA_START=20230101
KLINE_MAX_ATTEMPTS=3
KLINE_MAX_WORKERS=4
# Tushare Token（https://tushare.pro/ 注册后在个人主页获取）
TUSHARE_TOKEN=<your_tushare_token>

# ============================ 申万行业同步 ============================
SW_INIT_START_DATE=20240101
SW_DOWNLOAD_BATCH=200
SW_MAX_WORKERS=5

# ============================ 定时任务调度 ============================
# true 启动内嵌调度器；false 只跑 API，定时任务由独立进程 -m app.scheduler 承担
SCHEDULER_ENABLED=true

# ============================ AI 分析（DashScope 通义千问） ===========
# 阿里云百炼 API Key，https://bailian.console.aliyun.com/
# 不配置时：
#   - catalyst 任务会失败并写日志
#   - sentiment 任务自动降级为关键词规则分析
DASHSCOPE_API_KEY=<your_dashscope_api_key>
QWEN_MODEL=qwen-max
EMBEDDING_MODEL=text-embedding-v4
LLM_MODEL=qwen-plus

# ============================ 代理（可选） ============================
# 访问 Yahoo Finance 等海外数据源时使用，本机 Clash 端口通常是 7890/7897
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890